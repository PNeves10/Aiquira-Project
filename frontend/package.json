{
  "name": "aiquira-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:ci": "jest --ci --coverage && playwright test",
    "test:performance": "playwright test performance/",
    "test:accessibility": "jest --config jest.accessibility.config.js",
    "test:accessibility:monitor": "jest --config jest.accessibility.config.js --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:a11y": "axe --exit --chrome-options=\"--headless\" http://localhost:3000",
    "test:a11y:ci": "axe --exit --chrome-options=\"--headless\" --tags wcag2a,wcag2aa,wcag2aaa http://localhost:3000",
    "lighthouse": "lhci autorun",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "preview": "vite preview"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.10",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "next": "^13.2.4",
    "next-auth": "^4.24.13",
    "next-i18next": "^15.4.2",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-datepicker": "^8.9.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.66.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.3.5",
    "tailwindcss": "^4.1.17",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.0",
    "@axe-core/react": "^4.11.0",
    "@lhci/cli": "^0.15.1",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.0.8",
    "@storybook/blocks": "^8.6.11",
    "@storybook/react": "^10.0.8",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.0.33",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "autoprefixer": "^10.4.22",
    "axe-core": "^4.8.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.3",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "lighthouse": "^13.0.1",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.stories.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
